# Container images and build sandboxes (distributed via Releases, not git)
*.sif
*.sif.*
SIF/
rapdtool*_build/

# Databases (downloaded separately; see README)
*.msh
database/
db/

# Local dev scratch
local/

# Old build sandboxes and superseded experiments kept only on disk. This tree was
# swept into the repo by a broad 'git add -A' and carried 2.7 GB in 59,765 files
# until it was removed from the history.
_archive/

# examples/ ships the two input files and nothing else. A run's output directory is
# reproducible from them, and the per-bin mash reports inside one are ~140 MB of
# intermediates that no reader opens.
examples/*/

# Manual sources / working figures (only the built PDF + final figure are tracked)
*.docx
docs/*_new.png
docs/*_new.svg

# Python / editor cruft
__pycache__/
*.pyc
*.swp
*~
.DS_Store

# Local validation artifacts for the held 2.3.2 release (not part of the distribution)
validation/
